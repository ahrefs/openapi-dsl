license: "MIT"
tags: ["openapi" "dsl"]
homepage: "https://github.com/ahrefs/openapi-dsl"
bug-reports: "https://github.com/ahrefs/openapi-dsl/issues"
depends: [
  "dune" {>= "3.23"}
  "ocaml" {>= "4.13"}
  "jsonkit" {>= "1.1.0"}
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ahrefs/openapi-dsl.git"
x-maintenance-intent: ["(latest)"]
